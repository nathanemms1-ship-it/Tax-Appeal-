# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/

# Environment — NEVER commit these.
# This repo's env includes a Supabase service key, a Lob live key, a Stripe
# secret key, and a bank account id. There was no .gitignore before this file,
# so a single `git add .` would have committed all of them.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# local helper, not for the repo
setkey.sh

_to_delete/
.env*

# Texas appraisal roll downloads — scripts/tx/fetch.mjs writes here.
# These are public data, re-downloadable at any time from the URLs in
# scripts/tx/sources.json, and they are HUGE: one Nueces certified export is
# 161 MB zipped and 7.08 GB unpacked. GitHub refuses any file over 100 MB, so a
# stray `git add .` would either fail the push or, worse, succeed on the smaller
# ones and bloat the repo history permanently. The manifest belongs in git; the
# payload does not.
tx-data/
